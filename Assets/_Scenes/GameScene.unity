--- !u!114 &1430881150
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1430881148}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4697742cd652e19488b9866de02b5917, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogeSystem
  m_dialogText: {fileID: 2009987416}
  m_speedText: 0.06
  m_audioSource: {fileID: 214666669}
  m_dialogs:
  - type: 0
    text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0439
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u043C\u043E\u0434\u0443\u043B\u044F, \u043A\u0430\u043F\u0438\u0442\u0430\u043D
      ;)\L\u0424\u0438\u043A\u0441\u0438\u0440\u0443\u044E \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u043C\u043E\u0434\u0443\u043B\u044F \u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
      \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F
      \u0438 \u043E\u0441\u043C\u043E\u0441\u0430 \u0432\u043E\u0434\u044B. \u041D\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0435 \u043C\u0435\u043D\u044E
      - \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u0430 \u043C\u043E\u0434\u0443\u043B\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430, \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0435\u0433\u043E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
    clip: {fileID: 8300000, guid: 1af2e65560f92c742871e2edb6f95491, type: 3}
  - type: 1
    text: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0441\u0432\u044F\u0437\u0438
      \u0441 \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u044F
      \u2116676. \u041E\u0442\u043A\u043B\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0435\u043D!
      \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u043A\u0430\u043F\u0438\u0442\u0430\u043D!
      \u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443, \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0438 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044C
      \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u0443\u044E \u043F\u043E\u0441\u0430\u0434\u043A\u0443
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u0439.
      \u041F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435 \u043D\u0430\u0448\u0438
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u044B
      \u0438\u0437 \u0441\u0442\u0440\u043E\u044F, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0441\u0432\u044F\u0437\u0438 -
      \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E, \u044F \u043D\u0435
      \u043D\u0430\u0445\u043E\u0436\u0443 \u0438\u0445 \u0432 \u0441\u0430\u043C\u043E\u043C
      \u043A\u043E\u0440\u0430\u0431\u043B\u0435. \u041D\u043E \u0441\u0430\u043C\u043E\u0435
      \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E\u0435 \u0434\u043B\u044F \u043D\u0430\u0441
      - \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
      \u0434\u043B\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u043B\u0451\u0442\u043E\u0432. \u0418\u0437 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
      - \u044F \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E \u0441\u0438\u0433\u043D\u0430\u043B\u044B
      \u044F\u0432\u043D\u043E \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0435
      \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043C \u043D\u0430\u0448\u0435\u0433\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u041D\u043E, \u043F\u043E\u043C\u0438\u043C\u043E
      \u044D\u0442\u043E\u0433\u043E, \u044F \u0442\u0430\u043A\u0436\u0435 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E
      \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438.
      \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u0432\u0430\u043C
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443
      \u0441\u0438\u0433\u043D\u0430\u043B\u0443 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0433\u043E
      \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430. \u0414\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435\u0441\u044C
      \u0440\u043E\u0431\u043E\u0442\u043E\u043C-\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u043C
      \u043C\u043E\u0434\u0435\u043B\u0438 W01Ter. \u0411\u0443\u0434\u044C\u0442\u0435
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B \u0438 \u0432\u0435\u0440\u043D\u0438\u0442\u0435
      \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u044B, \u043A\u0430\u043F\u0438\u0442\u0430\u043D!"
    clip: {fileID: 8300000, guid: 0f366e378058c224eb60852831f927a3, type: 3}
  - type: 3
    text: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
      \u041D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
      - \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F
      \u0417\u0430 \u0432\u0440\u0435\u043C\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F \u0431\u044B\u043B
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u0441\u0438\u0433\u043D\u0430\u043B
      - \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E
      \u044D\u0442\u043E \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440\u043D\u044B\u0439
      \u0441\u0438\u0433\u043D\u0430\u043B \u0438\u0441\u043A\u043E\u043C\u043E\u0433\u043E
      \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430 \u0412\u044B\u0441\u044B\u043B\u0430\u044E
      \u0432\u0430\u043C \u0435\u0433\u043E \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B"
    clip: {fileID: 8300000, guid: 602644ed26d2177499315d35a492a87a, type: 3}
  - type: 2
    text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0439
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u043C\u043E\u0434\u0443\u043B\u044F, \u043A\u0430\u043F\u0438\u0442\u0430\u043D
      ;)\L\u0424\u0438\u043A\u0441\u0438\u0440\u0443\u044E \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0443\u043B\u044F
      \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F\L\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0434\u043B\u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
      \u043F\u043E\u043B\u0451\u0442\u0430... \u0424\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B
      \u043F\u043E\u043B\u0451\u0442\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D!"
    clip: {fileID: 8300000, guid: 333a020674de60e4d8aecb418fb237ce, type: 3}
  - type: 0
    text: 
    clip: {fileID: 0}
  - type: 0
